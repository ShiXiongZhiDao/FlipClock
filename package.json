{
  "name": "flipclock",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:app": "tauri build --no-bundle",
    "preview": "vite preview",
    "tauri": "tauri",
    "scr": "node scripts/package-scr.mjs",
    "ship": "pnpm build:app && pnpm scr",
    "check:version": "node scripts/check-version.mjs",
    "check:i18n": "node scripts/check-i18n.mjs && node scripts/check-i18n-runtime.mjs",
    "release": "node scripts/release.mjs",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
